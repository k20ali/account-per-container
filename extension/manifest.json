{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.2.0",
  "default_locale": "en",
  "icons": {
    "48": "icon.svg"
  },
  "permissions": [
    "storage",
    "contextualIdentities",
    "cookies",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "page_action": {
    "browser_style": true,
    "default_popup": "pageaction.html",
    "default_title": "__MSG_extensionButtonTitle__",
    "default_icon": "icon-blue.svg"
  },
  "options_ui": {
    "browser_style": false,
    "page": "options.html"
  },
  "incognito": "not_allowed",
  "browser_specific_settings": {
    "gecko": {
      "id": "{8f0db8b6-12fc-49b5-bb86-7cf9ab4b6302}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ]
      }
    }
  }
}